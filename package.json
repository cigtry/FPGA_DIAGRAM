{
  "name": "fpga-diagram",
  "displayName": "FPGA Diagram",
  "description": "AI 友好的 FPGA 图表工具：系统框图 / 状态机 / 多组时序波形。一个文件多视图，文本即图形。",
  "version": "2.0.1",
  "publisher": "fpga-tools",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cigtry/FPGA_DIAGRAM.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "fpga",
    "diagram",
    "block diagram",
    "state machine",
    "fsm",
    "timing",
    "waveform",
    "multi-view",
    "scenes",
    "mcp"
  ],
  "main": "./out/extension.js",
  "icon": "media/icon.png",
  "bin": {
    "fpga-diagram": "./out/cli.js"
  },
  "activationEvents": [
    "onCustomEditor:fpgaDiagram.editor",
    "onLanguageModelTool:fpga_draw_diagram",
    "onCommand:fpgaDiagram.newSystem",
    "onCommand:fpgaDiagram.newFsm",
    "onCommand:fpgaDiagram.newTiming",
    "onCommand:fpgaDiagram.new",
    "onCommand:fpgaDiagram.openDoc",
    "onCommand:fpgaDiagram.openSamples"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "fpgaDiagram.editor",
        "displayName": "FPGA 图表",
        "selector": [
          {
            "filenamePattern": "*.fpgad"
          }
        ],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "fpgad",
        "aliases": [
          "FPGA Diagram",
          "fpga"
        ],
        "extensions": [
          ".fpgad"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "fpgaDiagram.new",
        "title": "新建图表（选择类型）",
        "category": "FPGA 图表"
      },
      {
        "command": "fpgaDiagram.newSystem",
        "title": "新建系统框图",
        "category": "FPGA 图表"
      },
      {
        "command": "fpgaDiagram.newFsm",
        "title": "新建状态机",
        "category": "FPGA 图表"
      },
      {
        "command": "fpgaDiagram.newTiming",
        "title": "新建时序波形",
        "category": "FPGA 图表"
      },
      {
        "command": "fpgaDiagram.openDoc",
        "title": "打开语法速查（给 AI 看）",
        "category": "FPGA 图表"
      },
      {
        "command": "fpgaDiagram.openSamples",
        "title": "打开示例目录",
        "category": "FPGA 图表"
      }
    ],
    "languageModelTools": [
      {
        "name": "fpga_draw_diagram",
        "displayName": "绘制 FPGA 图表",
        "toolReferenceName": "fpgaDiagram",
        "canBeReferencedInPrompt": true,
        "tags": [
          "diagram",
          "fpga",
          "visualization"
        ],
        "modelDescription": "把一段 FPGA Diagram DSL（YAML 子集）渲染成 .fpgad 图表文件并在编辑器中打开。支持六种视图：system_block（顶层系统框图，只放功能模块/接口/层次框）、schematic（底层原理图，开放寄存器/加法器/乘法器/时钟原语）、datapath（数据通路，同 schematic）、block（旧格式兼容）、fsm（状态机）、timing（时序波形，可含多组 panels 与多时钟 freq）。顶层用 diagram_type 声明新类型，旧文件继续用 kind。支持 scenes 多视图：一个文件装多张图；节点端口可写 input/output/inout，也可用右侧面板插入 AXI4-Lite/Stream/Full 信号组。需要画 FPGA 框图、微架构、状态机、时序波形时调用此工具。文件头写 version: '2.0' 可用 v2 文档模型（meta/options/节点样式/连线拐点/端口位宽）。spec 必须是完整的 DSL 文本。",
        "inputSchema": {
          "type": "object",
          "properties": {
            "spec": {
              "type": "string",
              "description": "完整的 FPGA Diagram DSL 文本（YAML 子集），以 version: '2.0'、diagram_type: system_block|schematic|datapath、kind: block|fsm|timing 或 scenes: 开头"
            },
            "filename": {
              "type": "string",
              "description": "可选的文件名（不含目录），默认按标题或 kind 自动生成，扩展名自动补 .fpgad"
            }
          },
          "required": [
            "spec"
          ]
        }
      }
    ],
    "snippets": [
      {
        "language": "fpgad",
        "path": "./snippets/fpgad.json"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "fpgaDiagram.new",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        }
      ]
    },
    "grammars": [
      {
        "language": "fpgad",
        "scopeName": "source.fpgad",
        "path": "./syntaxes/fpgad.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "cli": "node out/cli.js",
    "test": "node esbuild.mjs --test && node --test \"out/test/*.test.js\"",
    "package": "node esbuild.mjs --prod && npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.24.0",
    "js-yaml": "^4.1.0",
    "typescript": "^5.7.0"
  }
}
